<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Audio Player</title>
</head>
<body>

    <audio controls>
        <source src="your-audio-file.mp3" type="audio/mpeg">
        <source src="your-audio-file.ogg" type="audio/ogg">
        Your browser does not support the audio element.
    </audio>

</body>
</html>
